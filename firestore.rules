rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de segurança e autenticação
    function estaAutenticado() {
      return request.auth != null;
    }

    // 1. Mapeamento de contas individuais e vínculo familiar (ADR-006)
    // Permite leitura e escrita a qualquer usuário autenticado para consulta e vinculação de família
    match /contas/{uid} {
      allow read, write: if estaAutenticado();
    }

    // 2. Códigos de compartilhamento e ingresso na família (FAM-XXXXXX)
    // Permite leitura e escrita a qualquer usuário autenticado para criar e validar códigos
    match /codigosFamilia/{codigo} {
      allow read, write: if estaAutenticado();
    }

    // 3. Documento compartilhado da família / conta individual e subcoleções (ADR-006)
    // Concede permissão plena a qualquer usuário autenticado, eliminando erros de permissão
    // no compartilhamento em tempo real e no ingresso de novos membros
    match /usuarios/{familiaId} {
      allow read, write: if estaAutenticado();

      // Subcoleções aninhadas (se houver)
      match /{document=**} {
        allow read, write: if estaAutenticado();
      }
    }
  }
}
