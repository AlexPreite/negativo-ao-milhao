rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de segurança e autenticação
    function estaAutenticado() {
      return request.auth != null;
    }

    function ehDonoDaConta(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    // 1. Mapeamento de contas individuais e vínculo familiar
    // Cada usuário autenticado pode ler e atualizar seu próprio registro de conta
    match /contas/{uid} {
      allow read: if estaAutenticado();
      allow write: if ehDonoDaConta(uid);
    }

    // 2. Códigos de compartilhamento e ingresso na família (FAM-XXXXXX)
    // Permite que qualquer usuário autenticado leia/valide o código para entrar na família
    // Criação permitida por usuários autenticados para convidar membros
    match /codigosFamilia/{codigo} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado();
      allow update, delete: if estaAutenticado() && (
        resource == null || resource.data.criadoPor == request.auth.uid
      );
    }

    // 3. Documento compartilhado da família / conta individual
    // Acesso permitido se:
    // - O documento é a conta individual do usuário (familiaId == auth.uid)
    // - O usuário está na lista de membros autorizados (membrosUids)
    // - Base legada familiar compartilhada (familia-alex-gabi)
    // - Documento novo em criação (resource == null)
    match /usuarios/{familiaId} {
      allow read, write: if estaAutenticado() && (
        resource == null ||
        familiaId == request.auth.uid ||
        familiaId == 'familia-alex-gabi' ||
        (resource.data.membrosUids is list && request.auth.uid in resource.data.membrosUids)
      );

      // Subcoleções aninhadas (se houver)
      match /{document=**} {
        allow read, write: if estaAutenticado();
      }
    }
  }
}
